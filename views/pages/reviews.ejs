<%- include('../partials/header') %>

<!-- Reviews Heading -->
<section class="schedule-section">
  <h2 class="section-heading">Student Reviews</h2>
  <p style="text-align: center;">
    Read what our students have to say about their learning experience with us.
  </p>

  <!-- Average Rating Display -->
  <% if (typeof totalReviews !== 'undefined' && totalReviews > 0) { %>
    <div class="average-rating-wrapper">
      <div class="average-rating">
        <span class="rating-number"><%= averageRating %></span>
        <span class="rating-star">★</span>
        <span class="rating-text">from <%= totalReviews %> review<%= totalReviews !== 1 ? 's' : '' %></span>
      </div>
    </div>
  <% } %>

  <!-- Reviews List -->
  <div class="review-container">
    <% if (reviews.length === 0) { %>
      <p style="text-align: center;">No reviews yet. Be the first to leave a review!</p>
    <% } else { %>
      <% reviews.forEach(review => { %>
        <div class="review-card">
          <div class="review-header">
            <div class="review-name"><%= review.name %></div>
            <div class="review-rating">
              <% for (let i = 0; i < review.rating; i++) { %>★<% } %>
              <% for (let i = review.rating; i < 5; i++) { %>☆<% } %>
            </div>
          </div>
          <p class="review-comment"><%= review.comment %></p>
          <div class="review-footer-accent">
            <span class="review-date-pill">
              <%= new Date(review.submitted_at).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              }) %>
            </span>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Review Submission Form -->
  <div class="review-form-container">
    <div class="card-header">
      <div class="card-header review-form-header">Leave a Review</div>
    </div>
    <div class="card-body">
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form id="review-form" action="/reviews" method="POST">
        <div class="form-group">
          <label for="review-name">Your Name <span>*</span></label>
          <input
            type="text"
            id="review-name"
            name="name"
            class="form-control"
            value="<%= locals.formData ? formData.name : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label>Rating <span>*</span></label>
          <div class="star-rating">
            <% for (let i = 5; i >= 1; i--) { %>
              <input
                type="radio"
                id="star<%= i %>"
                name="rating"
                value="<%= i %>"
                <%= locals.formData && formData.rating == i ? 'checked' : '' %>
              >
              <label for="star<%= i %>">★</label>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label for="review-comment">Your Review <span>*</span></label>
          <textarea
            id="review-comment"
            name="comment"
            class="form-control"
            rows="5"
            required
          ><%= locals.formData ? formData.comment : '' %></textarea>
        </div>

        <div class="form-group">
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
